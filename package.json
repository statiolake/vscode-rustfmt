{
  "name": "vscode-rustfmt",
  "displayName": "vscode-rustfmt",
  "description": "document formatter for single rust file",
  "publisher": "statiolake",
  "license": "MIT",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/statiolake/vscode-rustfmt/"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Rustfmt",
        "properties": {
          "rustfmt.path": {
            "type": "string",
            "default": "rustfmt",
            "description": "Path to rustfmt executable"
          },
          "rustfmt.edition": {
            "type": "string",
            "default": "2021",
            "enum": [
              "2015",
              "2018",
              "2021",
              "2024"
            ],
            "description": "Edition of Rust"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "build": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package",
    "publish": "npm run publish:vsce && npm run publish:ovsx",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.1.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "zod": "^3.22.4"
  }
}
